<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net462;net472;net48</TargetFrameworks>
    <TargetFrameworks>$(TargetFrameworks);net6.0;net7.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <UserSecretsId>28b4bdf9-6518-4588-b320-458aecdbee51</UserSecretsId>
    <!-- The adapters and tests use internals through InternalsVisibleTo. Verify's own are all in
         VerifyTests and are kept whole. What Polyfill adds is hidden from them
         (PolyUseEmbeddedAttribute), so it is trimmed where nothing in Verify uses it. -->
    <Squash_InternalNamespacesToKeep>VerifyTests</Squash_InternalNamespacesToKeep>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sbom" PrivateAssets="all" />
    <PackageReference Include="Squash" PrivateAssets="all" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="DiffEngine" />
    <PackageReference Include="SimpleInfoName" />
    <PackageReference Include="Argon" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />

    <None Include="buildTransitive\Verify.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Verify.props" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\Verify.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Verify.targets" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\Verify.AfterMicrosoftNetSdk.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Verify.AfterMicrosoftNetSdk.props" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>
  <Target Name="CheckPackageVersion" BeforeTargets="Build">
    <Error Condition="'%(PackageVersion.Identity)' == 'System.ValueTuple' AND '%(PackageVersion.Version)' != '4.5.0'" Text="Invalid package version for System.ValueTuple. Expected: 4.5.0." />
    <Error Condition="'%(PackageVersion.Identity)' == 'System.Collections.Immutable' AND '%(PackageVersion.Version)' != '8.0.0'" Text="Invalid package version for System.Collections.Immutable. Expected: 8.0.0." />
  </Target>
</Project>
